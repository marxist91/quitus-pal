# ============================================================================
# Configuration Django - Système de Gestion des Quitus PAL
# ============================================================================
# Copier ce fichier en .env et remplir avec vos valeurs réelles
# Ne JAMAIS commiter le fichier .env (contient des secrets)
# ============================================================================

# ----------------------------------------------------------------------------
# Django Core Settings
# ----------------------------------------------------------------------------
SECRET_KEY=votre-clé-secrète-django-très-longue-et-aléatoire-ici
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ----------------------------------------------------------------------------
# Base de Données MySQL (Production)
# ----------------------------------------------------------------------------
DB_ENGINE=django.db.backends.mysql
DB_NAME=quitus_pal
DB_USER=root
DB_PASSWORD=votre_mot_de_passe_mysql
DB_HOST=localhost
DB_PORT=3306

# ----------------------------------------------------------------------------
# Configuration Email (SMTP)
# ----------------------------------------------------------------------------
# Provider: Gmail, Outlook, SendGrid, Mailgun, etc.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# Credentials (Gmail: utiliser mot de passe d'application)
EMAIL_HOST_USER=votre-email@togoport.tg
EMAIL_HOST_PASSWORD=votre-mot-de-passe-application

# Adresses d'envoi
DEFAULT_FROM_EMAIL=noreply@togoport.tg
SERVER_EMAIL=admin@togoport.tg

# ----------------------------------------------------------------------------
# Notifications - Configuration
# ----------------------------------------------------------------------------
# Nombre de jours avant expiration pour envoyer l'alerte
NOTIFICATION_DAYS_BEFORE_EXPIRY=7

# Nombre maximum de tentatives de renvoi en cas d'échec
NOTIFICATION_MAX_RETRIES=3

# Délai en secondes avant nouvelle tentative (3600 = 1 heure)
NOTIFICATION_RETRY_DELAY=3600

# ----------------------------------------------------------------------------
# Sécurité (Production uniquement)
# ----------------------------------------------------------------------------
# Décommenter pour production:
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True

# ----------------------------------------------------------------------------
# Logging
# ----------------------------------------------------------------------------
# Niveau de logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ----------------------------------------------------------------------------
# Rate Limiting
# ----------------------------------------------------------------------------
# Nombre maximum de tentatives de connexion échouées
RATE_LIMIT_MAX_ATTEMPTS=5

# Fenêtre de temps pour le rate limiting (en secondes)
RATE_LIMIT_WINDOW=300

# ----------------------------------------------------------------------------
# Timezone & Langue
# ----------------------------------------------------------------------------
TIME_ZONE=Africa/Abidjan
LANGUAGE_CODE=fr-fr

# ----------------------------------------------------------------------------
# Media & Static Files
# ----------------------------------------------------------------------------
# Chemins relatifs au BASE_DIR
MEDIA_ROOT=media
STATIC_ROOT=staticfiles
STATIC_URL=/static/
MEDIA_URL=/media/

# ----------------------------------------------------------------------------
# Notes d'utilisation
# ----------------------------------------------------------------------------
# 1. Gmail : Activer "Mots de passe d'applications" (2FA requis)
#    https://myaccount.google.com/apppasswords
#
# 2. MySQL : Créer la base de données avant migrate:
#    CREATE DATABASE quitus_pal CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#
# 3. Production : Générer SECRET_KEY sécurisée avec:
#    python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#
# 4. Migrations après configuration:
#    python manage.py migrate
#
# 5. Créer superuser:
#    python manage.py createsuperuser
# ============================================================================
